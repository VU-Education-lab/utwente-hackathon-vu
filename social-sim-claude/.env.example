# ─────────────────────────────────────────────────────────────
# social-sim-claude — browser env
# ─────────────────────────────────────────────────────────────
# The browser NO LONGER reads API keys. All Azure OpenAI and
# ElevenLabs calls go through /api/* (see api/ folder). Keys live
# in api/local.settings.json (dev) or Azure Application Settings
# (prod). See SECURITY.md for the full threat model.

# Deployment name to send as `model` in the chat body. Optional —
# the proxy falls back to its server-side AZURE_OPENAI_DEPLOYMENT.
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Override the /api base URL (e.g. for an external Functions host
# during `npm run dev` without `swa start`). Defaults to /api.
# VITE_API_BASE=http://localhost:7071/api

VITE_APP_TITLE=Social Sim
VITE_APP_URL=http://localhost:5173
