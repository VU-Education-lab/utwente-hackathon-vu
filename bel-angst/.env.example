# ──────────────────────────────────────────────────────────────
#  bel-angst — runtime config example
# ──────────────────────────────────────────────────────────────
# For local dev, create a file `bel-angst/local-config.js` (gitignored)
# that assigns window.BEL_ANGST_CONFIG, e.g.:
#
#   window.BEL_ANGST_CONFIG = {
#     AZURE_REALTIME_ENDPOINT: "https://your-realtime.openai.azure.com",
#     AZURE_REALTIME_KEY:      "...",
#     AZURE_FEEDBACK_ENDPOINT: "https://your-chat.openai.azure.com",
#     AZURE_FEEDBACK_KEY:      "..."
#   };
#
# Include it from index.html with <script src="local-config.js"></script>
# BEFORE the main module. For production, these values come from /api/config
# (Azure Function reading Application Settings) — keys never touch the bundle.

AZURE_REALTIME_ENDPOINT=https://YOUR-REALTIME-RESOURCE.openai.azure.com
AZURE_REALTIME_KEY=
AZURE_FEEDBACK_ENDPOINT=https://YOUR-CHAT-RESOURCE.openai.azure.com
AZURE_FEEDBACK_KEY=
